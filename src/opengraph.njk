---js
{
  pagination: {
    data: "collections.contentPages",
    size: 1,
    alias: "preview"
  },
  permalink: "/.opengraph{{preview.url}}",
  eleventyExcludeFromCollections: true
}
---

{% extends 'src/_layouts/opengraph.njk' %}

{% set title = preview.data.title | default("") %}
{% set titleLength = title | length %}

{# This doesn't use the css Nunjucks block because using it conflicts with the 
   one in the opengraph layout, apparently. #}
{% block head %}
<style>
.pageOverrideTitleSize {
  display: -webkit-box;
  margin-block-end: 0;
  padding-block-end: .1em; /* Fix descenders being cut off */
  font-size: var(--size-5);
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
{% endblock %}

{% block title %}
  {%- if preview.data.isBlogPost %}
    <div class="kimHeading-m kim-!-margin-block-start-0">
      {{ preview.date | formatDate('human') }}
    </div>
    <div class="kimHeading-xl kim-!-margin-block-start-0 {%- if titleLength >= 50 %} pageOverrideTitleSize{% endif %}">
      {{ title | markdownInline | safe }}
    </div>
  {%- elif preview.url == '/' %}
    <div class="kimHeading-xl">
      Cryptid critter<br>
      builds websites<br>
      and writes stuff.
    </div>
  {%- else %}
    <div class="kimHeading-xl">
      {{ (preview.data.title or "") | markdownInline | safe }}
    </div>
  {%- endif %}
{% endblock %}
